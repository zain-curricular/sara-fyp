# ============================================================================
# marketplace — self-contained Docker stack (Supabase + Next app)
# ============================================================================
# One command (from repo root):   npm run docker:up
# or (from this docker/ folder):  docker compose up
#
# ─── HOST PORTS ─────────────────────────────────────────────────────────────
# Every published port lives here, in a 56xxx range so this stack NEVER collides
# with the other local Supabase project (55xxx) or a default CLI stack (543xx).
# If a port is already taken on your machine, change it HERE only — nothing else
# needs touching, and no other project is disturbed.
KONG_HTTP_PORT=56321          # Supabase API gateway — the app + browser talk here
POSTGRES_EXTERNAL_PORT=56322  # Postgres (psql / external tools)
STUDIO_PORT=56323             # Supabase Studio (DB dashboard)
APP_PORT=3202                 # Next.js app → http://localhost:3202

# ─── KEYS / SECRETS ─────────────────────────────────────────────────────────
# These are the SAME local demo keys the Supabase CLI uses, so this stack is
# drop-in interchangeable with `supabase start`. Local-only; not secret.
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600
# JWKS form of the JWT secret (contains the HS256 symmetric key = JWT_SECRET,
# base64url-encoded). storage-api validates/roles tokens via JWKS, so without this
# it fails to recognise the service_role key and denies uploads with an RLS error.
JWT_JWKS={"keys":[{"kty":"EC","kid":"b81269f1-21d8-4f2e-b719-c2240a840d90","use":"sig","key_ops":["verify"],"alg":"ES256","ext":true,"crv":"P-256","x":"M5Sjqn5zwC9Kl1zVfUUGvv9boQjCGd45G8sdopBExB4","y":"P6IXMvA2WYXSHSOMTBH2jsw_9rrzGy89FjPf6oOsIxQ"},{"kty":"oct","k":"c3VwZXItc2VjcmV0LWp3dC10b2tlbi13aXRoLWF0LWxlYXN0LTMyLWNoYXJhY3RlcnMtbG9uZw"}]}
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Realtime / postgres-meta encryption
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1Au2oq
REALTIME_DB_ENC_KEY=supabaserealtime
PG_META_CRYPTO_KEY=marketplace-pg-meta-crypto-key-32chars

# Storage S3 protocol (local demo values)
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907

# Studio
STUDIO_DEFAULT_ORGANIZATION=Marketplace
STUDIO_DEFAULT_PROJECT=marketplace
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=supabase

# OpenAI — OPTIONAL. Needed only for AI search / similar / chatbot embeddings.
# Without it, the app runs and image seeding still works; embeddings are skipped.
OPENAI_API_KEY=
